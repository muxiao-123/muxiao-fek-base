{
  "name": "muxiao-fek-base",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky install",
    "commit": "git add . && git-cz",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:sync:vue3": "node scripts/sync-skills.mjs --project=vue3-app",
    "skills:sync:react": "node scripts/sync-skills.mjs --project=react-app"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "commitizen": "^4.3.1",
    "commitlint": "^20.5.3",
    "cz-git": "^1.13.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.7",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --config .oxlintrc.js"
    ],
    "*.{json,md,mdx}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
